# Copia questo file in ".env.local" (solo per provare sul computer).
# Su Vercel le stesse due variabili vanno in Settings → Environment Variables.
# Le trovi in Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=la-chiave-anon-public

# Fase 2 — chiave PUBBLICA VAPID per le notifiche (README, passo 7).
# La chiave PRIVATA non va mai qui: va solo nei segreti di Supabase.
VITE_VAPID_PUBLIC_KEY=la-chiave-pubblica-vapid
